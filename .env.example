# ==== Server ====
PORT=5432

# ==== MongoDB ====
# Lokal MongoDB yoki Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cs2-marketplace

# ==== JWT (shart) ====
# Juda uzun tasodifiy satr kiriting, masalan:
#   openssl rand -hex 48
# Server JWT_SECRET'siz ishga tushmaydi.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==== Cloudinary (rasm bazasi) ====
# Cloudinary hisobidan olingan ma'lumotlar:
# https://cloudinary.com/console -> Settings -> Account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== Ixtiyoriy: admin yaratish (npm run seed) ====
# Agar bu ikkala qiymat to'ldirilsa, seed skripti admin
# foydalanuvchini yaratadi (parol bcrypt bilan hash qilinadi).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
